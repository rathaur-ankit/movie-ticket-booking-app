# ==========================================
# Frontend Environment Variables
# (Used by Frontend dev server & Docker Compose build args)
# ==========================================
# Clerk publishable key for user authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Currency symbol displayed across the application
VITE_CURRENCY=$

# Backend API base URL
VITE_BASE_URL=http://localhost:5000

# TMDB image CDN base URL
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/original

# ==========================================
# Backend Environment Variables
# (Used by Backend server / Backend/.env)
# ==========================================
# Server port
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017

# Allowed CORS origins
CORS_ORIGIN=*

# Frontend application URL (used for payment redirection URLs)
CLIENT_URL=http://localhost:5173

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Inngest Serverless Event Management
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# TMDB API (The Movie Database)
TMDB_API_KEY=your_tmdb_api_key

# Stripe Payment Gateway
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Email Service (Nodemailer / SMTP)
SENDER_EMAIL=your_email@example.com
SMTP_USER=your_smtp_username
SMTP_PASS_KEY=your_smtp_password
